# ==========================================
# Bob the Builder - Example Configuration
# ==========================================

# Android environment
#
# Leave these empty to use the environment
# already configured on your system.

ANDROID_HOME="$HOME/Android/Sdk"
JAVA_HOME=""


# ==========================================
# Projects
# ==========================================
#
# Format:
#
# PROJECT_<project_name>="<path relative
# to the directory where bob is invoked>"
#
# Add your own projects below.
#
# Example:
#
# PROJECT_MyApp="./MyApp"
# PROJECT_MyService="./services/MyService"
#
# Project names should contain only letters,
# numbers and underscores.


